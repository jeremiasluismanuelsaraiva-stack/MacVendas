"use strict";


// =====================================================
// URL BASE DA API
// =====================================================

const API_BASE_URL = "/api";


// =====================================================
// GET
// =====================================================

async function apiGet(endpoint) {

    try {

        const resposta =
            await fetch(
                API_BASE_URL + endpoint,
                {
                    method: "GET",

                    headers: {
                        "Accept":
                            "application/json"
                    },

                    cache:
                        "no-store"
                }
            );


        if (!resposta.ok) {

            throw new Error(
                "Erro HTTP " +
                resposta.status
            );

        }


        return await resposta.json();

    }
    catch (erro) {

        console.error(
            "[MOZ API] Erro GET:",
            endpoint,
            erro
        );

        throw erro;

    }

}


// =====================================================
// POST
// =====================================================

async function apiPost(
    endpoint,
    dados
) {

    try {

        const resposta =
            await fetch(
                API_BASE_URL + endpoint,
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json",

                        "Accept":
                            "application/json"
                    },

                    body:
                        JSON.stringify(
                            dados
                        )
                }
            );


        if (!resposta.ok) {

            throw new Error(
                "Erro HTTP " +
                resposta.status
            );

        }


        return await resposta.json();

    }
    catch (erro) {

        console.error(
            "[MOZ API] Erro POST:",
            endpoint,
            erro
        );

        throw erro;

    }

}


