"use strict";

// =====================================================
// MOZ TECH
// API CLIENT
// =====================================================


const API_BASE_URL =
    "/api";


// =====================================================
// CREDENCIAIS
// =====================================================

let MOZ_UID =
    localStorage.getItem(
        "moz_uid"
    ) || "";


let MOZ_API_KEY =
    localStorage.getItem(
        "moz_api_key"
    ) || "";


// =====================================================
// DEFINIR CREDENCIAIS
// =====================================================

function definirCredenciais(
    uid,
    apiKey
) {

    MOZ_UID =
        String(uid || "")
            .trim();

    MOZ_API_KEY =
        String(apiKey || "")
            .trim();


    if (MOZ_UID) {

        localStorage.setItem(
            "moz_uid",
            MOZ_UID
        );

    }


    if (MOZ_API_KEY) {

        localStorage.setItem(
            "moz_api_key",
            MOZ_API_KEY
        );

    }


    // ---------------------------------------------
    // GLOBAL
    // ---------------------------------------------

    window.MOZ_CREDENCIAIS_API = {

        uid:
            MOZ_UID,

        apiKey:
            MOZ_API_KEY

    };


    console.log(
        "[MOZ API] Credenciais definidas."
    );

}


// =====================================================
// OBTER CREDENCIAIS
// =====================================================

function obterCredenciais() {

    return {

        uid:
            MOZ_UID,

        apiKey:
            MOZ_API_KEY

    };

}


// =====================================================
// PROCESSAR RESPOSTA
// =====================================================

async function processarResposta(
    resposta
) {

    let dados = null;


    try {

        dados =
            await resposta.json();

    }
    catch (erro) {

        dados = null;

    }


    if (!resposta.ok) {

        const mensagem =
            dados?.error ||
            dados?.message ||
            "Erro HTTP " +
            resposta.status;


        throw new Error(
            mensagem
        );

    }


    return dados;

}


// =====================================================
// HEADERS
// =====================================================

function criarHeaders(
    incluirJSON = false
) {

    const headers = {

        "Accept":
            "application/json"

    };


    if (incluirJSON) {

        headers[
            "Content-Type"
        ] =
            "application/json";

    }


    // =================================================
    // ENVIAR CREDENCIAIS
    // =================================================

    if (MOZ_UID) {

        headers["x-uid"] =
            MOZ_UID;

    }


    if (MOZ_API_KEY) {

        headers["x-api-key"] =
            MOZ_API_KEY;

    }


    return headers;

}


// =====================================================
// GET
// =====================================================

async function apiGet(
    endpoint
) {

    const resposta =
        await fetch(
            API_BASE_URL +
            endpoint,
            {

                method:
                    "GET",

                headers:
                    criarHeaders(false),

                credentials:
                    "include",

                cache:
                    "no-store"

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// POST
// =====================================================

async function apiPost(
    endpoint,
    dados = {}
) {

    const corpo = {

        ...dados

    };


    // =================================================
    // ADICIONAR CREDENCIAIS
    // =================================================

    if (
        MOZ_UID &&
        !corpo.uid
    ) {

        corpo.uid =
            MOZ_UID;

    }


    if (
        MOZ_API_KEY &&
        !corpo.apiKey
    ) {

        corpo.apiKey =
            MOZ_API_KEY;

    }


    const resposta =
        await fetch(
            API_BASE_URL +
            endpoint,
            {

                method:
                    "POST",

                headers:
                    criarHeaders(true),

                credentials:
                    "include",

                body:
                    JSON.stringify(
                        corpo
                    )

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// PUT
// =====================================================

async function apiPut(
    endpoint,
    dados = {}
) {

    const corpo = {

        ...dados

    };


    if (
        MOZ_UID &&
        !corpo.uid
    ) {

        corpo.uid =
            MOZ_UID;

    }


    if (
        MOZ_API_KEY &&
        !corpo.apiKey
    ) {

        corpo.apiKey =
            MOZ_API_KEY;

    }


    const resposta =
        await fetch(
            API_BASE_URL +
            endpoint,
            {

                method:
                    "PUT",

                headers:
                    criarHeaders(true),

                credentials:
                    "include",

                body:
                    JSON.stringify(
                        corpo
                    )

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// DELETE
// =====================================================

async function apiDelete(
    endpoint
) {

    const resposta =
        await fetch(
            API_BASE_URL +
            endpoint,
            {

                method:
                    "DELETE",

                headers:
                    criarHeaders(false),

                credentials:
                    "include"

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// API GLOBAL
// =====================================================

window.MOZ_API = {

    get:
        apiGet,

    post:
        apiPost,

    put:
        apiPut,

    delete:
        apiDelete,

    definirCredenciais:
        definirCredenciais,

    obterCredenciais:
        obterCredenciais

};


// =====================================================
// COMPATIBILIDADE
// =====================================================

window.apiGet =
    apiGet;

window.apiPost =
    apiPost;

window.apiPut =
    apiPut;

window.apiDelete =
    apiDelete;


// =====================================================
// INICIALIZAR GLOBAL
// =====================================================

window.MOZ_CREDENCIAIS_API = {

    uid:
        MOZ_UID,

    apiKey:
        MOZ_API_KEY

};


console.log(
    "[MOZ API] API carregada:",
    API_BASE_URL
);
