"use strict";

// =====================================================
// MOZ TECH
// API CLIENT
// public/js/api.js
// =====================================================


const API_BASE_URL = "/api";


// =====================================================
// CREDENCIAIS
// =====================================================

let MOZ_UID =
    localStorage.getItem("moz_uid") || "";

let MOZ_API_KEY =
    localStorage.getItem("moz_api_key") || "";


// =====================================================
// DEFINIR CREDENCIAIS
// =====================================================

function definirCredenciais(uid, apiKey) {

    MOZ_UID =
        String(uid || "").trim();

    MOZ_API_KEY =
        String(apiKey || "").trim();


    if (MOZ_UID) {

        localStorage.setItem(
            "moz_uid",
            MOZ_UID
        );

    }


    if (MOZ_API_KEY) {

        localStorage.setItem(
            "moz_api_key",
            MOZ_API_KEY
        );

    }


    window.MOZ_CREDENCIAIS_API = {

        uid: MOZ_UID,

        apiKey: MOZ_API_KEY

    };


    console.log(
        "[MOZ API] Credenciais definidas."
    );

}


// =====================================================
// OBTER CREDENCIAIS
// =====================================================

function obterCredenciais() {

    return {

        uid: MOZ_UID,

        apiKey: MOZ_API_KEY

    };

}


// =====================================================
// ATUALIZAR CREDENCIAIS DO FIREBASE
// =====================================================

function atualizarCredenciais(uid, apiKey) {

    definirCredenciais(
        uid,
        apiKey
    );

}


// =====================================================
// PROCESSAR RESPOSTA
// =====================================================

async function processarResposta(resposta) {

    let dados = null;


    try {

        dados =
            await resposta.json();

    }
    catch (erro) {

        dados = null;

    }


    if (!resposta.ok) {

        const mensagem =
            dados?.error ||
            dados?.message ||
            "Erro HTTP " + resposta.status;


        throw new Error(
            mensagem
        );

    }


    return dados;

}


// =====================================================
// HEADERS
// =====================================================

function criarHeaders(incluirJSON = false) {

    const headers = {

        "Accept":
            "application/json"

    };


    if (incluirJSON) {

        headers[
            "Content-Type"
        ] =
            "application/json";

    }


    // =================================================
    // UID
    // =================================================

    if (MOZ_UID) {

        headers["x-uid"] =
            MOZ_UID;

    }


    // =================================================
    // API KEY
    // =================================================

    if (MOZ_API_KEY) {

        headers["x-api-key"] =
            MOZ_API_KEY;

    }


    return headers;

}


// =====================================================
// CONSTRUIR URL
// =====================================================

function construirURL(endpoint) {

    endpoint =
        String(endpoint || "")
            .trim();


    if (!endpoint) {

        throw new Error(
            "Endpoint da API não informado."
        );

    }


    if (!endpoint.startsWith("/")) {

        endpoint =
            "/" + endpoint;

    }


    return (
        API_BASE_URL +
        endpoint
    );

}


// =====================================================
// GET
// =====================================================

async function apiGet(endpoint) {

    const resposta =
        await fetch(
            construirURL(endpoint),
            {

                method:
                    "GET",

                headers:
                    criarHeaders(false),

                credentials:
                    "include",

                cache:
                    "no-store"

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// POST
// =====================================================

async function apiPost(
    endpoint,
    dados = {}
) {

    const corpo = {

        ...dados

    };


    if (
        MOZ_UID &&
        !corpo.uid
    ) {

        corpo.uid =
            MOZ_UID;

    }


    if (
        MOZ_API_KEY &&
        !corpo.apiKey
    ) {

        corpo.apiKey =
            MOZ_API_KEY;

    }


    const resposta =
        await fetch(
            construirURL(endpoint),
            {

                method:
                    "POST",

                headers:
                    criarHeaders(true),

                credentials:
                    "include",

                body:
                    JSON.stringify(
                        corpo
                    )

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// PUT
// =====================================================

async function apiPut(
    endpoint,
    dados = {}
) {

    const corpo = {

        ...dados

    };


    if (
        MOZ_UID &&
        !corpo.uid
    ) {

        corpo.uid =
            MOZ_UID;

    }


    if (
        MOZ_API_KEY &&
        !corpo.apiKey
    ) {

        corpo.apiKey =
            MOZ_API_KEY;

    }


    const resposta =
        await fetch(
            construirURL(endpoint),
            {

                method:
                    "PUT",

                headers:
                    criarHeaders(true),

                credentials:
                    "include",

                body:
                    JSON.stringify(
                        corpo
                    )

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// DELETE
// =====================================================

async function apiDelete(endpoint, dados = {}) {

    const corpo = {

        ...dados

    };


    if (
        MOZ_UID &&
        !corpo.uid
    ) {

        corpo.uid =
            MOZ_UID;

    }


    if (
        MOZ_API_KEY &&
        !corpo.apiKey
    ) {

        corpo.apiKey =
            MOZ_API_KEY;

    }


    const opcoes = {

        method:
            "DELETE",

        headers:
            criarHeaders(
                Object.keys(corpo).length > 0
            ),

        credentials:
            "include"

    };


    if (
        Object.keys(corpo).length > 0
    ) {

        opcoes.body =
            JSON.stringify(
                corpo
            );

    }


    const resposta =
        await fetch(
            construirURL(endpoint),
            opcoes
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// API GLOBAL
// =====================================================

window.MOZ_API = {

    get:
        apiGet,

    post:
        apiPost,

    put:
        apiPut,

    delete:
        apiDelete,

    definirCredenciais:
        definirCredenciais,

    atualizarCredenciais:
        atualizarCredenciais,

    obterCredenciais:
        obterCredenciais

};


// =====================================================
// COMPATIBILIDADE
// =====================================================

window.apiGet =
    apiGet;

window.apiPost =
    apiPost;

window.apiPut =
    apiPut;

window.apiDelete =
    apiDelete;


// =====================================================
// CREDENCIAIS GLOBAIS
// =====================================================

window.MOZ_CREDENCIAIS_API = {

    uid:
        MOZ_UID,

    apiKey:
        MOZ_API_KEY

};


// =====================================================
// LOG
// =====================================================

console.log(
    "[MOZ API] API carregada:",
    API_BASE_URL
);
