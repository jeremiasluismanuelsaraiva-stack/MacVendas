"use strict";

// =====================================================
// MOZ TECH - API CLIENT
// =====================================================

const API_BASE_URL = "/api";


// =====================================================
// FUNÇÃO AUXILIAR
// =====================================================

async function processarResposta(resposta) {

    let dados = null;

    try {

        dados = await resposta.json();

    }
    catch (erro) {

        dados = null;

    }


    if (!resposta.ok) {

        const mensagem =
            dados?.error ||
            dados?.message ||
            "Erro HTTP " + resposta.status;

        throw new Error(mensagem);

    }


    return dados;

}


// =====================================================
// GET
// =====================================================

async function apiGet(endpoint) {

    const resposta =
        await fetch(
            API_BASE_URL + endpoint,
            {
                method: "GET",

                headers: {
                    "Accept":
                        "application/json"
                },

                credentials:
                    "include",

                cache:
                    "no-store"
            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// POST
// =====================================================

async function apiPost(
    endpoint,
    dados = {}
) {

    const resposta =
        await fetch(
            API_BASE_URL + endpoint,
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json",

                    "Accept":
                        "application/json"
                },

                credentials:
                    "include",

                body:
                    JSON.stringify(dados)
            }
        );


    return await processarResposta(
        resposta
    );

}


