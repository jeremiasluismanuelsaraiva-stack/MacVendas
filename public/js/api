// =====================================================
// DELETE
// =====================================================

async function apiDelete(
    endpoint,
    dados = {}
) {

    obterCredenciais();


    const corpo = {

        ...dados

    };


    if (
        MOZ_UID &&
        !corpo.uid
    ) {

        corpo.uid =
            MOZ_UID;

    }


    if (
        MOZ_API_KEY &&
        !corpo.apiKey
    ) {

        corpo.apiKey =
            MOZ_API_KEY;

    }


    const possuiCorpo =
        Object.keys(
            corpo
        ).length > 0;


    const opcoes = {

        method:
            "DELETE",

        headers:
            criarHeaders(
                possuiCorpo
            ),

        credentials:
            "include"

    };


    if (possuiCorpo) {

        opcoes.body =
            JSON.stringify(
                corpo
            );

    }


    const url =
        construirURL(
            endpoint
        );


    console.log(
        "[MOZ API] DELETE:",
        url
    );


    const resposta =
        await fetch(
            url,
            opcoes
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// API GLOBAL
// =====================================================

window.MOZ_API = {

    get:
        apiGet,

    post:
        apiPost,

    put:
        apiPut,

    delete:
        apiDelete,

    definirCredenciais:
        definirCredenciais,

    atualizarCredenciais:
        atualizarCredenciais,

    atualizarCredenciaisFirebase:
        atualizarCredenciaisFirebase,

    obterCredenciais:
        obterCredenciais

};


// =====================================================
// COMPATIBILIDADE
// =====================================================

window.apiGet =
    apiGet;

window.apiPost =
    apiPost;

window.apiPut =
    apiPut;

window.apiDelete =
    apiDelete;


// =====================================================
// CREDENCIAIS GLOBAIS
// =====================================================

window.MOZ_CREDENCIAIS_API = {

    uid:
        MOZ_UID,

    apiKey:
        MOZ_API_KEY

};


// =====================================================
// SINCRONIZAR AO CARREGAR
// =====================================================

if (
    MOZ_UID &&
    MOZ_API_KEY
) {

    console.log(
        "[MOZ API] Credenciais encontradas no localStorage."
    );

}
else {

    console.log(
        "[MOZ API] Credenciais ainda não disponíveis."
    );

}


// =====================================================
// LOG
// =====================================================

console.log(
    "[MOZ API] API carregada:",
    API_BASE_URL
);


// =====================================================
// EXPORTAR
// =====================================================

if (
    typeof window !== "undefined"
) {

    window.definirCredenciais =
        definirCredenciais;

    window.obterCredenciais =
        obterCredenciais;

}
