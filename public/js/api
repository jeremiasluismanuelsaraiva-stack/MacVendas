"use strict";

// =====================================================
// MOZ TECH
// API CLIENT
// public/js/api.js
// =====================================================

const API_BASE_URL = "/api";

// =====================================================
// CREDENCIAIS
// =====================================================

let MOZ_UID =
    localStorage.getItem("uid") || "";

let MOZ_API_KEY =
    localStorage.getItem("apiKey") || "";


// =====================================================
// DEFINIR CREDENCIAIS
// =====================================================

function definirCredenciais(uid, apiKey) {

    MOZ_UID =
        String(uid || "").trim();

    MOZ_API_KEY =
        String(apiKey || "").trim();


    // =================================================
    // SALVAR NO MESMO LOCALSTORAGE DO FIREBASE
    // =================================================

    if (MOZ_UID) {

        localStorage.setItem(
            "uid",
            MOZ_UID
        );

    }
    else {

        localStorage.removeItem(
            "uid"
        );

    }


    if (MOZ_API_KEY) {

        localStorage.setItem(
            "apiKey",
            MOZ_API_KEY
        );

    }
    else {

        localStorage.removeItem(
            "apiKey"
        );

    }


    // =================================================
    // CREDENCIAIS GLOBAIS
    // =================================================

    window.MOZ_CREDENCIAIS_API = {

        uid:
            MOZ_UID,

        apiKey:
            MOZ_API_KEY

    };


    console.log(
        "[MOZ API] Credenciais definidas."
    );

    console.log(
        "[MOZ API] UID:",
        MOZ_UID || "(não definido)"
    );

}


// =====================================================
// OBTER CREDENCIAIS
// =====================================================

function obterCredenciais() {

    // -------------------------------------------------
    // Tentar atualizar diretamente do localStorage
    // -------------------------------------------------

    const uidStorage =
        localStorage.getItem("uid");

    const apiKeyStorage =
        localStorage.getItem("apiKey");


    if (uidStorage) {

        MOZ_UID =
            uidStorage.trim();

    }


    if (apiKeyStorage) {

        MOZ_API_KEY =
            apiKeyStorage.trim();

    }


    return {

        uid:
            MOZ_UID,

        apiKey:
            MOZ_API_KEY

    };

}


// =====================================================
// ATUALIZAR CREDENCIAIS DO FIREBASE
// =====================================================

async function atualizarCredenciaisFirebase() {

    try {

        // -------------------------------------------------
        // Firebase já disponibilizou a função
        // -------------------------------------------------

        if (
            typeof window.obterDadosUsuario ===
            "function"
        ) {

            const dados =
                await window.obterDadosUsuario();


            if (
                dados &&
                dados.uid &&
                dados.apiKey
            ) {

                definirCredenciais(
                    dados.uid,
                    dados.apiKey
                );


                console.log(
                    "[MOZ API] Credenciais sincronizadas com Firebase."
                );


                return {
                    uid:
                        dados.uid,

                    apiKey:
                        dados.apiKey
                };

            }

        }

    }
    catch (erro) {

        console.warn(
            "[MOZ API] Não foi possível sincronizar com Firebase:",
            erro
        );

    }


    // -------------------------------------------------
    // Fallback: localStorage
    // -------------------------------------------------

    return obterCredenciais();

}


// =====================================================
// COMPATIBILIDADE
// =====================================================

async function atualizarCredenciais(
    uid,
    apiKey
) {

    // Se foram fornecidas manualmente
    if (
        uid &&
        apiKey
    ) {

        definirCredenciais(
            uid,
            apiKey
        );

        return obterCredenciais();

    }


    // Caso contrário, buscar Firebase
    return await atualizarCredenciaisFirebase();

}


// =====================================================
// PROCESSAR RESPOSTA
// =====================================================

async function processarResposta(
    resposta
) {

    let dados = null;


    try {

        dados =
            await resposta.json();

    }
    catch (erro) {

        dados = null;

    }


    if (!resposta.ok) {

        const mensagem =
            dados?.error ||
            dados?.message ||
            "Erro HTTP " +
            resposta.status;


        console.error(
            "[MOZ API] HTTP " +
            resposta.status + ":",
            mensagem
        );


        throw new Error(
            mensagem
        );

    }


    return dados;

}


// =====================================================
// HEADERS
// =====================================================

function criarHeaders(
    incluirJSON = false
) {

    // Atualizar valores do localStorage
    obterCredenciais();


    const headers = {

        "Accept":
            "application/json"

    };


    if (incluirJSON) {

        headers[
            "Content-Type"
        ] =
            "application/json";

    }


    // =================================================
    // UID
    // =================================================

    if (MOZ_UID) {

        headers[
            "x-uid"
        ] =
            MOZ_UID;

    }


    // =================================================
    // API KEY
    // =================================================

    if (MOZ_API_KEY) {

        headers[
            "x-api-key"
        ] =
            MOZ_API_KEY;

    }


    return headers;

}


// =====================================================
// CONSTRUIR URL
// =====================================================

function construirURL(
    endpoint
) {

    endpoint =
        String(endpoint || "")
            .trim();


    if (!endpoint) {

        throw new Error(
            "Endpoint da API não informado."
        );

    }


    if (
        !endpoint.startsWith("/")
    ) {

        endpoint =
            "/" +
            endpoint;

    }


    return (
        API_BASE_URL +
        endpoint
    );

}


// =====================================================
// GET
// =====================================================

async function apiGet(
    endpoint
) {

    const url =
        construirURL(
            endpoint
        );


    console.log(
        "[MOZ API] GET:",
        url
    );


    const resposta =
        await fetch(
            url,
            {

                method:
                    "GET",

                headers:
                    criarHeaders(false),

                credentials:
                    "include",

                cache:
                    "no-store"

            }
        );


    return await processarResposta(
        resposta
    );

}


// =====================================================
// POST
// =====================================================

async function apiPost(
    endpoint,
    dados = {}
) {

    obterCredenciais();


    const corpo = {

        ...dados

    };


    if (
        MOZ_UID &&
        !corpo.uid
    ) {

        corpo.uid =
            MOZ_UID;

    }


    if (
        MOZ_API_KEY &&
        !corpo.apiKey
    ) {

        corpo.apiKey =
            MOZ_API_KEY;

    }


    const url =
        construirURL(
            endpoint
        );


    console.log(
        "[MOZ API] POST:",
        url
    );


    const resposta =
        await fetch(
            url,
            {

                method:
                    "POST",

                headers:
                    criarHeaders(true),

                credentials:
                    "include",

                body:
                    JSON.stringify(
                        corpo
                    )

            }
        );


    return await processarResposta(
        resposta
    );

}


